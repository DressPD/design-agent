# ─── Design Agent — Environment Variables ───
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Load before running:
#   set -a; source .env; set +a

# ─── AI API Keys ───
GOOGLE_API_KEY=your-google-api-key-here
TWENTYFIRST_API_KEY=your-21st-api-key-here

# ─── GitHub ───
# Personal Access Token — repos are created under YOUR account.
# Create at: https://github.com/settings/tokens → "Generate new token (classic)"
# Required scopes: repo, delete_repo
GITHUB_TOKEN=your-github-pat-here

# ─── AWS Credentials ───
# Option A: SSO profile (if you have AWS SSO configured)
# AWS_PROFILE=your-sso-profile
#
# Option B: Static credentials (recommended for testers)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=optional-session-token

AWS_DEFAULT_REGION=eu-central-1

# ─── Infrastructure (optional — defaults are hardcoded) ───
# Override only if you deploy your own S3 bucket + CloudFront.
# DESIGN_AGENT_S3_BUCKET=design-agent-sites-363437155153
# DESIGN_AGENT_CF_DIST_ID=E13CVD2UT1V127
# DESIGN_AGENT_CF_DOMAIN=djth7oc46jvbj.cloudfront.net
