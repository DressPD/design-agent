# ─── Design Agent — Environment Variables ───
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Load before running:
#   set -a; source .env; set +a

# ─── AI API Keys ───
GOOGLE_API_KEY=your-google-api-key
TWENTYFIRST_API_KEY=your-21st-dev-api-key

# ─── GitHub ───
# Personal Access Token — repos are created under YOUR account.
# Create at: https://github.com/settings/tokens → "Generate new token (classic)"
# Required scopes: repo, delete_repo
GITHUB_TOKEN=ghp_your-token-here

# ─── AWS Credentials ───
# Option A: SSO profile (recommended if you have AWS SSO configured)
# AWS_PROFILE=your-sso-profile
#
# Option B: Static credentials (for containers or CI)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=optional-session-token

AWS_DEFAULT_REGION=eu-central-1

# ─── Infrastructure (optional — defaults to pre-provisioned resources) ───
# Override these if you ran your own terraform apply:
# DESIGN_AGENT_S3_BUCKET=your-bucket-name
# DESIGN_AGENT_CF_DIST_ID=your-distribution-id
# DESIGN_AGENT_CF_DOMAIN=your-cf-domain.cloudfront.net
