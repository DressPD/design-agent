# ─── Design Agent — Required Environment Variables ───
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The agent reads these at startup. All are required.

# ─── AI API Keys ───
# Google Stitch (UI design generation)
GOOGLE_API_KEY=your-google-api-key

# 21st.dev Magic (React component library)
TWENTYFIRST_API_KEY=your-21st-dev-api-key

# ─── GitHub ───
# Personal Access Token — determines which account repos are created under.
# Create at: https://github.com/settings/tokens → "Generate new token (classic)"
# Required scopes: repo, delete_repo
GITHUB_TOKEN=ghp_your-token-here

# ─── AWS Credentials ───
# For S3 deployment + CloudFront invalidation + Bedrock model access.
# Option A: Set these env vars directly (for local/container use).
# Option B: Use IAM role (for ECS Fargate — leave these unset).
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=eu-central-1

# Optional: session token (for temporary credentials / SSO)
# AWS_SESSION_TOKEN=your-session-token
